# Copy to .env. Anything starting with EXPO_PUBLIC_ is baked into the app when you build it.
#
# The address of your Ghar Direct server.
#   Testing on a real phone with Expo Go:   http://YOUR-COMPUTER-IP:8080   (same Wi-Fi as the phone)
#   Android emulator on the same computer:  http://10.0.2.2:8080
#   iOS simulator on the same computer:     http://localhost:8080
#   After you deploy the server:            https://your-server.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080
