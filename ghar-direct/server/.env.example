# Copy this file to .env and fill it in. Never commit .env.

PORT=8080

# Postgres connection string. Render and Railway give you this when you add a database.
DATABASE_URL=postgres://user:password@localhost:5432/ghardirect
# Set to true on hosts that require SSL for the database (Render, Railway, Neon, Supabase).
DATABASE_SSL=false

# A long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Needed to open /admin and review reports. Leave empty to turn the admin page off.
ADMIN_TOKEN=

# Where photos are stored. "local" writes to UPLOAD_DIR (fine for testing, NOT durable on most hosts).
# Use "s3" for any real launch (works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces).
STORAGE=local
UPLOAD_DIR=./uploads
# The public address of this server, used to build photo links when STORAGE=local.
PUBLIC_BASE_URL=http://localhost:8080

# Only for STORAGE=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address where photos in the bucket can be viewed, for example https://photos.yourdomain.com
S3_PUBLIC_URL=

# Photo verification rules
MIN_PHOTOS=6
MAX_PHOTOS=10
# How close (in metres) the phone must be to the flat when a photo is taken.
MAX_PHOTO_DISTANCE_M=150
# How long (in minutes) a photo request stays valid after the app asks for it.
NONCE_TTL_MIN=10

# ID check provider. "stub" approves everyone and is for testing only.
ID_PROVIDER=stub
